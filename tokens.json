{
  "$meta": {
    "name": "Sistema Nevados · design tokens v1",
    "source_of_truth": "tokens.css",
    "note": "Si un valor difiere entre este JSON y tokens.css, manda tokens.css."
  },
  "brand": {
    "navy": "#00334e",
    "navy-deep": "#06283a",
    "snow": "#ffffff"
  },
  "slate": {
    "50": "#f6f8fa",
    "100": "#eef2f6",
    "150": "#f4f6f8",
    "200": "#d3dde6",
    "300": "#a9bac9",
    "400": "#7d93a7",
    "500": "#64748b",
    "600": "#4c6172",
    "700": "#3a4c5b",
    "800": "#26333e",
    "900": "#16212a"
  },
  "accent": {
    "copper-100": "#fbeedd",
    "copper-500": "#c96f2e",
    "copper-700": "#96521f"
  },
  "nature": {
    "lenga-100": "#e3efe7",
    "lenga-500": "#2f6b4f",
    "lenga-700": "#1e4a37",
    "glacier-100": "#e0f2fe",
    "glacier-500": "#0ea5e9",
    "glacier-700": "#075985"
  },
  "semantic": {
    "ok": { "bg": "#d1fae5", "fg": "#065f46", "solid": "#10b981" },
    "warn": { "bg": "#fef3c7", "fg": "#92400e", "solid": "#f59e0b" },
    "ember": { "bg": "#ffedd5", "fg": "#9a3412", "solid": "#ea580c" },
    "bad": { "bg": "#fee2e2", "fg": "#991b1b", "solid": "#ef4444" },
    "info": { "bg": "#e0f2fe", "fg": "#075985", "solid": "#0ea5e9" }
  },
  "type": {
    "family-sans": "Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif",
    "family-mono": "ui-monospace, SF Mono, Cascadia Mono, Menlo, Consolas, monospace",
    "display": "clamp(2.4rem, 1.4rem + 4vw, 4.2rem)/1.05/800",
    "h2": "clamp(1.5rem, 1.2rem + 1.4vw, 2.1rem)/1.05/800",
    "body": "0.95rem/1.55",
    "small": "0.82rem",
    "micro": "0.72rem"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "breakpoint": {
    "mobile-max": "767px",
    "desktop-min": "768px"
  },
  "rules": [
    "Un solo acento cálido (cobre); los semáforos no se reinventan.",
    "Montserrat siempre (self-hosted); mono solo para código/tokens.",
    "Radios: pill en acciones/chips, 16 en cards y paneles, 12 en insumos y controles, 8 en mini-tiles.",
    "768px: todo lo multi-columna colapsa a una columna.",
    "44px en captura y nav móvil; 32px mínimo en acciones compactas; iconos nunca bajo 16px.",
    "Sin hex fuera de esta lista."
  ]
}
